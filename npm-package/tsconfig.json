{
  "compilerOptions": {
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": "../../dist",
    "baseUrl": "./",
    "paths": {
      "@repo/a": ["../a/src"],
      "@repo/a/*": ["../a/src/*"],
      "@repo/b": ["../b/src"],
      "@repo/b/*": ["../b/src/*"]
    }
  },
  "include": ["src/**/*"]
}
